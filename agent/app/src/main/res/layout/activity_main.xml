<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingVertical="40dp">

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="14dp"
                android:drawableStart="@drawable/ic_launcher_small"
                android:gravity="center_vertical"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Préparation : mode développeur et débogage -->
            <LinearLayout
                android:id="@+id/setup_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/setup_step"
                    style="@style/Label"
                    android:layout_marginTop="0dp" />

                <TextView
                    android:id="@+id/setup_title"
                    style="@style/Body"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/setup_text"
                    style="@style/Body" />

                <Button
                    android:id="@+id/setup_open"
                    style="@style/Primary" />

                <Button
                    android:id="@+id/setup_skip"
                    style="@style/Secondary"
                    android:layout_marginTop="14dp"
                    android:text="@string/setup_skip" />
            </LinearLayout>

            <!-- Association -->
            <LinearLayout
                android:id="@+id/pair_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pair_step"
                    style="@style/Label"
                    android:layout_marginTop="0dp"
                    android:text="@string/pair_step"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/intro"
                    style="@style/Body"
                    android:text="@string/intro" />

                <TextView
                    style="@style/Label"
                    android:text="@string/code_label" />

                <EditText
                    android:id="@+id/code"
                    style="@style/Field"
                    android:hint="@string/code_hint"
                    android:imeOptions="actionDone"
                    android:inputType="number"
                    android:letterSpacing="0.3"
                    android:maxLength="6" />

                <TextView
                    android:id="@+id/error"
                    style="@style/Body"
                    android:textColor="@color/bad"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/pair"
                    style="@style/Primary"
                    android:text="@string/pair" />
            </LinearLayout>

            <!-- État -->
            <LinearLayout
                android:id="@+id/status_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/conn_line"
                    style="@style/Body"
                    android:layout_marginTop="0dp"
                    android:textColor="@color/text"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/adb_line"
                    style="@style/Body"
                    android:textColor="@color/text"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/hint"
                    style="@style/Body"
                    android:layout_marginTop="14dp" />

                <Button
                    android:id="@+id/open_dev"
                    style="@style/Primary"
                    android:text="@string/adb_open"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/unpair"
                    style="@style/Secondary"
                    android:text="@string/unpair" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
